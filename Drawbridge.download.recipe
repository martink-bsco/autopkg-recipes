<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads Drawbridge (arm64). The download URL is pinned to a version; update VERSION to pick up a new release.</string>
    <key>Identifier</key>
    <string>com.github.martink-bsco.download.drawbridge</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Drawbridge</string>
        <key>VERSION</key>
        <string>1.2.0</string>
    </dict>
    <key>MinimumVersion</key>
    <string>0.2.0</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>filename</key>
                <string>%NAME%-%VERSION%.dmg</string>
                <key>url</key>
                <string>https://drawbridge.fortiknight.com/download/files/v%VERSION%/Drawbridge-%VERSION%-arm64.dmg</string>
            </dict>
            <key>Processor</key>
            <string>URLDownloader</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>input_path</key>
                <string>%pathname%/Drawbridge.app</string>
                <key>requirement</key>
                <string>identifier "app.drawbridge.editor" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "9KQWQDX85R"</string>
            </dict>
            <key>Processor</key>
            <string>CodeSignatureVerifier</string>
        </dict>
    </array>
</dict>
</plist>
